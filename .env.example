# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Input
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Path to your Bitwarden-compatible password export (CSV or JSON).
# Format is auto-detected from file contents.
INPUT_PATH=/inputDir/inputFile.json

# Password for encrypted Bitwarden JSON exports.
# ⚠️ INSECURE: stored as plaintext on disk. Avoid committing this to version control.
# Prefer passing via CLI --export-password flag instead.
# EXPORT_PASSWORD=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HIBP Source
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# false = scan a local hashes file or split-file directory (requires HASHES_OF_LEAKS_PATH).
# true  = query the HIBP k-anonymity API over the network (no local file needed).
# USE_HIBP_API=false

# Path to the HIBP leaked-password hashes file or split-file directory (~90 GB as of 06.2026).
# Required when USE_HIBP_API=false.
# Single .txt file for the default HIBP download:
HASHES_OF_LEAKS_PATH=/inputDir/pwnedpasswords.txt
# Or point to a split-prefix directory (e.g. from PwnedPasswordsDownloader -s false):
# HASHES_OF_LEAKS_PATH=/inputDir/hashes/

# Base URL for the HIBP k-anonymity API (only when USE_HIBP_API=true).
# Must use HTTPS and end with a trailing slash (/).
# HIBP_API_URL=https://api.pwnedpasswords.com/range/

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Hash Type
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Password hash algorithm. Options: auto, sha1, ntlm.
#   auto  — detect from corpus content (40-char hash part / 35-char split suffix → sha1;
#           32 / 27 → ntlm). In API mode there is no corpus, so auto resolves to sha1 (with a notice).
#   sha1  — force SHA-1 (the default HIBP corpus format).
#   ntlm  — force NTLM (MD4 of UTF-16LE password); use the NTLM corpus from the
#           Pwned Passwords Downloader. Hashes are 32 hex chars; split suffixes are 27.
# HASH_TYPE=auto

# Behavior when the requested HASH_TYPE conflicts with the detected corpus type.
#   error — abort before scanning, naming the requested and detected types (default).
#   warn  — print a warning (stderr + summary), self-correct to the detected type, and continue.
# An ambiguous or unreadable corpus aborts in both modes.
# HASH_TYPE_MISMATCH=error

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Output
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Number of output targets (at least 1). Each output needs OUTPUT_{i}_FORMAT and
# OUTPUT_{i}_PATH where i is 0-indexed.
OUTPUT_COUNT=2

OUTPUT_0_FORMAT=csv
OUTPUT_0_PATH=/outputDir/outputFile.csv

OUTPUT_1_FORMAT=json
OUTPUT_1_PATH=/outputDir/outputFile.json

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Read Mode (local file scanning)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# How to scan the local hashes file. Options: auto, sequential, binary, index.
#   auto        — auto-detects disk type and sortedness, picks the fastest strategy.
#   sequential  — multi-chunk parallel sequential scan (works on any file).
#   binary      — binary search per hash (fast on SSDs with few hashes, requires sorted file).
#   index       — random-read via a pre-built .idx file (fastest for repeated runs).
#                 If no fresh .idx exists, runs one sequential scan that builds it.
# SINGLE_FILE_READ_MODE=auto

# Whether to build a .idx prefix-index file during the scan for faster future runs.
#   true  — builds a .idx as a side-effect of sequential scans (sequential/auto modes,
#           and index mode when bootstrapping a missing .idx). Skipped for unsorted files.
#   false — no .idx is created.
# BUILD_INDEX=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Security
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Include plaintext passwords, TOTP secrets, password history, and FIDO2 credentials
# in output. false (default) = only identification metadata and leak info are written.
# true = passwords, TOTP, history, and FIDO2 written in plaintext on disk.
# ⚠️ INSECURE: sensitive data written to disk. Avoid in shared environments.
# INCLUDE_SECRETS=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Advanced — internal tuning, rarely need to change
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Force a specific read mode, overriding SINGLE_FILE_READ_MODE and BUILD_INDEX.
# Useful for benchmarking and debugging.
# Values: binary | index | sequential-noindex | sequential-index
# READ_MODE_FORCED=

# Override the automatic parallel chunk count (auto-detected from disk speed and memory).
# CHUNK_COUNT=

# Minimum file size in bytes to run the disk speed test. Files below this use 1 chunk.
# SPEED_TEST_MIN_BYTES=

# Corpus size in bytes below which the sortedness check is skipped. Files at or
# above this size get the live sortedness check (default: 1073741824 = 1 GiB).
# SMALL_FILE_BYTES_THRESHOLD=

# Max concurrent reads for split-file directory mode.
# SPLIT_FILE_CONCURRENCY=1024

# Max concurrent requests for HIBP API mode.
# HIBP_CONCURRENCY=1000

# Max concurrent reads for index-based reader.
# INDEX_READER_CONCURRENCY=1024
