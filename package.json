{
  "name": "check-leaks-passwords",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "description": "Check if passwords from CSV or JSON file exist in a HIBP leaked hashes file. Supports CSV and JSON input/output formats, including encrypted Bitwarden exports.",
  "scripts": {
    "build": "tsc",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start": "npm run build:worker && tsx index.ts",
    "start:compiled": "npm run build:worker && node dist/index.js",
    "build:start:compiled": "npm run build && npm run start:compiled",
    "dry-run": "npm run build:worker && tsx index.ts --dry-run",
    "lint": "eslint index.ts src/ tests/",
    "lint-fix": "eslint --fix index.ts src/ tests/",
    "test": "npm run build:worker && vitest run",
    "test:watch": "npm run build:worker && vitest",
    "test:coverage": "npm run build:worker && vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build-index": "npm run build:worker && tsx src/scripts/buildIndex.ts",
    "generate-fixtures": "npm run build:worker && tsx scripts/generateTestFixtures.ts"
  },
  "dependencies": {
    "argon2": "^0.45.0",
    "chalk": "^5.6.2",
    "cli-progress": "^3",
    "fast-csv": "^5.0.7",
    "ora": "^9.4.1",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node26": "^26.0.0",
    "@types/cli-progress": "^3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.0",
    "eslint-stylistic-airbnb": "^3.2.0",
    "globals": "^17",
    "tsx": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
